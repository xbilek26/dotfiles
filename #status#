



repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

die() {
  printf 'status: %s\n' "$*" >&2
  exit 1
}

sync_dir() {
  local source_dir="$1"
  local target_dir="$2"

  [[ -d "$source_dir" ]] || die "missing directory: $source_dir"
  mkdir -p "$target_dir"
  rsync -a --delete "$source_dir"/ "$target_dir"/
}

sync_file() {
  local source_file="$1"
  local target_dir="$2"

  [[ -f "$source_file" ]] || die "missing file: $source_file"
  mkdir -p "$target_dir"
  cp -p "$source_file" "$target_dir"/
}

sync_dir "$HOME/.config/nvim" "$repo_dir/nvim"
sync_dir "$HOME/.config/tmux" "$repo_dir/tmux"
sync_file "$HOME/.bashrc" "$repo_dir/bash"
sync_file "$HOME/.config/gf2_config.ini" "$repo_dir/gf2"
sync_file "$HOME/.gitconfig" "$repo_dir/git"

rm -f "$repo_dir/nvim/nvim-pack-lock.json"

git -C "$repo_dir" status --short
